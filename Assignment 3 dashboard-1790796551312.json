                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT location,\r\n       COUNT(*) AS orders,\r\n       ROUND(SUM(final_amount)) AS revenue,\r\n       ROUND(AVG(delivery_time_mins), 1) AS avg_delivery_time,\r\n       ROUND(AVG(customer_rating), 2) AS avg_rating,\r\n       ROUND(AVG(distance_km), 1) AS avg_distance\r\nFROM orders\r\nGROUP BY location",
